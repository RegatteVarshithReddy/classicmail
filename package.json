{
  "name": "classicmail",
  "productName": "ClassicMail",
  "version": "0.2.0",
  "description": "An Outlook Classic-style desktop mail and calendar client for Ubuntu (IMAP/SMTP + ICS calendars).",
  "author": "Varshith",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env CLASSICMAIL_DEV=1 electron .\"",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dist": "npm run build:ui && electron-builder --linux deb AppImage --publish never",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "test:e2e": "node test/e2e/demo.e2e.js",
    "test:electron": "node test/e2e/electron.e2e.js"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smtp-server": "^3.19.13",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "local.classicmail.app",
    "productName": "ClassicMail",
    "copyright": "MIT licensed",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.4.5",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Varshith <varshith.regatte@gmail.com>",
      "synopsis": "Outlook Classic-style mail and calendar for Ubuntu",
      "description": "ClassicMail reads and sends mail from Gmail and other IMAP accounts in one window, with a read-only calendar view for ICS links and files.",
      "mimeTypes": [
        "x-scheme-handler/mailto"
      ],
      "executableName": "classicmail",
      "desktop": {
        "entry": {
          "Name": "ClassicMail",
          "Comment": "Mail and calendar",
          "Keywords": "mail;email;calendar;imap;gmail;",
          "StartupWMClass": "ClassicMail"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ],
      "recommends": [
        "gnome-keyring"
      ],
      "packageCategory": "mail"
    },
    "publish": null
  },
  "desktopName": "classicmail.desktop",
  "homepage": "https://github.com/RegatteVarshithReddy/classicmail"
}
